-- UIManager.lua
-- Updated for generated InventoryBrowser UI.
-- The old action/window name "VacpacGui" is kept for compatibility,
-- but the actual ScreenGui is now PlayerGui.InventoryBrowser.

-- Roblox Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

-- Remote / Bindable Events
local SharedRemotes = ReplicatedStorage:WaitForChild("SharedRemotes")
local GuiShownClientEvent  = SharedRemotes:WaitForChild("GuiShownClient")
local GuiShownServerEvent  = SharedRemotes:WaitForChild("GuiShownServer")
local GuiHiddenClientEvent = SharedRemotes:WaitForChild("GuiHiddenClient")
local GuiHiddenServerEvent = SharedRemotes:WaitForChild("GuiHiddenServer")

-- GUI
local SharedGUI = PlayerGui:WaitForChild("SharedGUI")
local HUDGui = SharedGUI:WaitForChild("HUDGui")

-- Generated by InventoryGuiHandler.client.lua / InventoryBrowser.lua.
-- Make sure InventoryGuiHandler is enabled at startup so this exists before UIManager.Init().
local InventoryBrowserGui = PlayerGui:WaitForChild("InventoryBrowser")

-- Modules
local ModeManager = require(game:GetService("StarterPlayer")
	:WaitForChild("StarterPlayerScripts")
	:WaitForChild("SharedClientScripts")
	:WaitForChild("ModeManager"))

local InputRoot = SharedGUI:WaitForChild("InputContexts")
local ContextSwitchingContext = InputRoot:WaitForChild("ContextSwitchingContext")
local ShowHUDAction = ContextSwitchingContext:WaitForChild("ShowHUDAction")
local ShowVacpacAction = ContextSwitchingContext:WaitForChild("ShowVacpacAction")

-- Browser close button fires this, then UIManager owns state/events.
local InventoryCloseRequested = PlayerGui:FindFirstChild("InventoryCloseRequested")
if not InventoryCloseRequested then
	InventoryCloseRequested = Instance.new("BindableEvent")
	InventoryCloseRequested.Name = "InventoryCloseRequested"
	InventoryCloseRequested.Parent = PlayerGui
end

local UIManager = {}

----------------------------------------------------------------
-- Per-window config
-- DeferEnabled = true  => UIManager only fires events; external system sets Enabled/Visible
-- DeferEnabled = false => UIManager sets ScreenGui.Enabled itself AND fires events
----------------------------------------------------------------
UIManager.GuiWindows = {
	HUDGui = {
		Gui = HUDGui,
		DeferEnabled = true, -- HUD managed elsewhere
	},

	-- Compatibility name. The action is still ShowVacpacAction and the events still
	-- use "VacpacGui", but there is no old VacpacGui ScreenGui anymore.
	VacpacGui = {
		Gui = InventoryBrowserGui,
		DeferEnabled = true, -- InventoryGuiHandler opens/closes/refreshed generated UI
	},
}

-- Tracks open/closed even when DeferEnabled=true
UIManager.OpenState = {} -- [guiName] = boolean
UIManager._closeRequestConnection = nil

local function connectCloseRequestOnce()
	if UIManager._closeRequestConnection then
		return
	end

	UIManager._closeRequestConnection = InventoryCloseRequested.Event:Connect(function()
		UIManager.Hide("VacpacGui")
	end)
end

----------------------------------------------------------------
-- Internal helpers
----------------------------------------------------------------
local function fireShown(name: string, screenGui: ScreenGui)
	GuiShownClientEvent:Fire(name, screenGui)
	GuiShownServerEvent:FireServer(name, screenGui)
end

local function fireHidden(name: string, screenGui: ScreenGui)
	GuiHiddenClientEvent:Fire(name, screenGui)
	GuiHiddenServerEvent:FireServer(name, screenGui)
end

local function resolveName(target): string?
	if typeof(target) == "string" then
		if UIManager.GuiWindows[target] then
			return target
		end
		warn(("[UIManager] Window '%s' is not registered"):format(target))
		return nil
	end

	if typeof(target) == "Instance" then
		-- Exact key/name first.
		if UIManager.GuiWindows[target.Name] then
			return target.Name
		end

		-- Then match by Gui object. This allows UIManager.Show(UIManager.GuiWindows.VacpacGui.Gui)
		-- even though the actual ScreenGui.Name is "InventoryBrowser".
		for name, entry in pairs(UIManager.GuiWindows) do
			if entry.Gui == target then
				return name
			end
		end

		warn(("[UIManager] ScreenGui '%s' is not registered"):format(target.Name))
		return nil
	end

	warn("[UIManager] Unsupported target:", target)
	return nil
end

local function isOpen(name: string, entry): boolean
	if entry.DeferEnabled then
		return UIManager.OpenState[name] == true
	end
	return entry.Gui.Enabled == true
end

local function setOpen(name: string, entry, shouldOpen: boolean)
	UIManager.OpenState[name] = shouldOpen

	if entry.DeferEnabled then
		-- External manager is responsible for enabling/disabling.
		if shouldOpen then
			fireShown(name, entry.Gui)
		else
			fireHidden(name, entry.Gui)
		end
		return
	end

	if entry.Gui.Enabled ~= shouldOpen then
		entry.Gui.Enabled = shouldOpen
	end

	if shouldOpen then
		fireShown(name, entry.Gui)
	else
		fireHidden(name, entry.Gui)
	end
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------
function UIManager.Init()
	print("UIManager Started..........");

	for name, entry in pairs(UIManager.GuiWindows) do
		if entry.DeferEnabled then
			UIManager.OpenState[name] = false
		else
			UIManager.OpenState[name] = entry.Gui.Enabled == true
		end
	end

	connectCloseRequestOnce()
end

function UIManager.Show(target)
	local targetName = resolveName(target)
	if not targetName then return end

	local targetEntry = UIManager.GuiWindows[targetName]
	assert(targetEntry, ("[UIManager][Show] guiWindow '%s' not registered in GuiWindows"):format(targetName))

	-- If already open: toggle everything OFF
	if isOpen(targetName, targetEntry) then
		for name, entry in pairs(UIManager.GuiWindows) do
			if isOpen(name, entry) then
				setOpen(name, entry, false)
			end
		end
		return
	end

	-- Otherwise: show this one, hide all others
	for name, entry in pairs(UIManager.GuiWindows) do
		local shouldShow = (name == targetName)
		if isOpen(name, entry) ~= shouldShow then
			setOpen(name, entry, shouldShow)
		end
	end
end

function UIManager.Hide(target)
	local targetName = resolveName(target)
	if not targetName then return end

	local entry = UIManager.GuiWindows[targetName]
	if entry and isOpen(targetName, entry) then
		setOpen(targetName, entry, false)
	end
end

function UIManager.IsOpen(target): boolean
	local name = resolveName(target)
	if not name then return false end
	local entry = UIManager.GuiWindows[name]
	return entry and isOpen(name, entry) or false
end

----------------------------------------------------------------
-- Input hookups
----------------------------------------------------------------
ShowHUDAction.Released:Connect(function()
	UIManager.Show("HUDGui")
end)

ShowVacpacAction.Released:Connect(function()
	-- Still use the compatibility window/action name.
	UIManager.Show("VacpacGui")
end)

connectCloseRequestOnce()

return UIManager
